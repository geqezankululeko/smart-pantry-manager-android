<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@drawable/ic_pantry"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pantry"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.SuggestedRecipesActivity" />
        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:parentActivityName=".ui.PantryActivity" />
        <activity
            android:name=".ui.PantryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
